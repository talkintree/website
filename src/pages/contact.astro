---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Contact Dr. Ramesh Kayyam for speaking, collaboration, media, or an inquiry.">
<section class="page-hero"><div class="container"><p class="eyebrow">Contact</p><h1>Let’s begin a meaningful conversation.</h1><p>For speaking engagements, collaborations, media inquiries, or a simple hello, please get in touch.</p></div></section>
<section class="paper section"><div class="container contact-grid"><div><p class="eyebrow">Reach out</p><h2>Interested in working together?</h2><p>Share a little about your event, organization, or idea. We will be in touch soon.</p><p class="email">talkintree85@gmail.com</p><p class="hint">Replace this placeholder email before the site launches.</p></div><form name="talkintree-contact" method="POST" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="talkintree-contact"/><p class="hidden"><label>Do not fill this out <input name="bot-field"/></label></p><label>Name<input required name="name" type="text" placeholder="Your name"/></label><label>Email<input required name="email" type="email" placeholder="you@example.com"/></label><label>How can we help?<textarea required name="message" rows="5" placeholder="Tell us about your inquiry"></textarea></label><button class="button dark-button" type="submit">Send inquiry</button></form></div></section>
</BaseLayout>
<style>.page-hero{padding:11rem 0 5rem;background:radial-gradient(circle at 75% 25%,#3b3322,#111 62%)}h1{font-size:clamp(3.3rem,7vw,6.2rem);letter-spacing:-.06em;max-width:850px;margin:.7rem 0}.page-hero p:not(.eyebrow){color:#d0c9bc;max-width:600px;font-size:1.08rem}.contact-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:7rem}.contact-grid h2{font-size:2.4rem;margin:1rem 0}.contact-grid p:not(.eyebrow){color:#5c574e}.email{font-family:'Playfair Display',serif;font-size:1.25rem!important;color:#7a5c23!important;margin-top:2rem!important}.hint{font-size:.76rem}.hidden{display:none}form{display:grid;gap:1rem}label{font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;font-weight:bold;color:#615b52}input,textarea{width:100%;display:block;margin-top:.4rem;padding:.85rem;background:#fffdf8;border:1px solid #cfc5b6;color:#111;font:inherit;font-size:.95rem;letter-spacing:normal;text-transform:none;font-weight:400}textarea{resize:vertical}.dark-button{justify-self:start}@media(max-width:700px){.contact-grid{grid-template-columns:1fr;gap:3rem}}</style>
