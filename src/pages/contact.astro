---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Dr. Ramesh Kayyam" description="Contact Dr. Ramesh Kayyam for speaking engagements, workshops, collaborations, media, and general inquiries.">
  <section class="contact-hero"><div class="orbit orbit-one" aria-hidden="true"></div><div class="orbit orbit-two" aria-hidden="true"></div><div class="container hero-content"><p class="eyebrow">Contact</p><h1>Let’s begin a meaningful conversation.</h1><p>For speaking engagements, workshops, collaborations, media inquiries, or a simple hello, please get in touch.</p><a class="button" href="#inquiry">Send an inquiry</a></div></section>

  <section class="paper section ways"><div class="container"><p class="eyebrow">Ways to connect</p><h2 class="section-title">A conversation can be the beginning of meaningful change.</h2><div class="ways-grid"><article><span>01</span><h3>Speaking & Workshops</h3><p>Invite Dr. Ramesh for a keynote, workshop, university session, leadership program, or virtual event.</p></article><article><span>02</span><h3>Collaborations</h3><p>Explore opportunities in leadership, education, AI, storytelling, research, or community impact.</p></article><article><span>03</span><h3>Media & Conversations</h3><p>Connect for interviews, podcast conversations, articles, book discussions, and thoughtful exchanges.</p></article></div></div></section>

  <section id="inquiry" class="paper section form-section"><div class="container contact-grid"><aside class="contact-aside"><p class="eyebrow">Reach out</p><h2>Tell us what is on your mind.</h2><p>Share a little about your event, organization, or idea. Every message is read with care.</p><a class="email" href="mailto:talkintree85@gmail.com">talkintree85@gmail.com</a><div class="social-links"><a href="https://www.linkedin.com/in/drrameshkayyam" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="https://youtube.com/@talkintree?si=PSgVE2khg-98-Zc6" target="_blank" rel="noreferrer">YouTube ↗</a></div><p class="reply-note">For a direct message, email is always welcome.</p></aside>
    <form name="talkintree-contact" method="POST" action="/thank-you" data-netlify="true" data-netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="talkintree-contact"/><p class="hidden"><label>Do not fill this out <input name="bot-field"/></label></p><div class="two-fields"><label>Name<input required name="name" type="text" autocomplete="name" placeholder="Your name"/></label><label>Email<input required name="email" type="email" autocomplete="email" placeholder="you@example.com"/></label></div><label>What would you like to discuss?<select required name="inquiry-type"><option value="" disabled selected>Select an option</option><option>Speaking or workshop</option><option>Collaboration</option><option>Media or podcast</option><option>Books or author inquiry</option><option>General message</option></select></label><label>Organization or website <span>(optional)</span><input name="organization" type="text" autocomplete="organization" placeholder="Organization name"/></label><label>Your message<textarea required name="message" rows="6" placeholder="Tell us a little about your inquiry, audience, or idea."></textarea></label><p class="privacy-note">Your information will only be used to respond to your inquiry. See the <a href="/privacy">Privacy Notice</a>.</p><button class="button dark-button" type="submit">Send inquiry</button></form>
  </div></section>

  <section class="contact-cta"><div class="container"><p class="eyebrow">Talkintree</p><h2>Ideas grow stronger when they are shared.</h2><a class="button" href="/blog">Visit Thought Garden</a></div></section>
</BaseLayout>

<style>
  .contact-hero{position:relative;overflow:hidden;min-height:665px;padding:11rem 0 6rem;background:radial-gradient(circle at 77% 24%,#4a3b21 0,#1a1712 45%,#0d0d0d 76%)}.hero-content{position:relative;z-index:2;max-width:900px}.hero-content h1{font-size:clamp(3.6rem,7vw,6.6rem);letter-spacing:-.07em;margin:.85rem 0 1.25rem}.hero-content>p:not(.eyebrow){max-width:600px;color:#d5cec1;font-size:1.12rem;margin-bottom:2rem}.orbit{position:absolute;border:1px solid rgba(214,181,107,.18);border-radius:50%}.orbit-one{width:580px;height:580px;right:-135px;bottom:-250px}.orbit-two{width:350px;height:350px;right:70px;bottom:-180px}
  .ways{padding-bottom:5.5rem}.ways-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:3.4rem;border-top:1px solid #d9d0c1;border-left:1px solid #d9d0c1}.ways-grid article{padding:1.55rem;min-height:250px;border-right:1px solid #d9d0c1;border-bottom:1px solid #d9d0c1}.ways-grid span{color:#8d6d30;font-size:.68rem;letter-spacing:.1em}.ways-grid h3{font-size:1.55rem;margin:2rem 0 .65rem}.ways-grid p{color:#5c564c;font-size:.93rem;margin:0}
  .form-section{padding-top:1rem}.contact-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:7rem}.contact-aside h2{font-size:clamp(2.2rem,4vw,3.5rem);margin:1rem 0}.contact-aside>p:not(.eyebrow){color:#5a544b}.email{display:block;color:#755a26;font-family:'Playfair Display',Georgia,serif;font-size:1.22rem;margin:2.25rem 0}.social-links{display:flex;gap:1.3rem;border-top:1px solid #d9d0c1;padding-top:1rem}.social-links a{color:#5d471c;font-size:.72rem;text-transform:uppercase;letter-spacing:.09em;font-weight:700}.reply-note{font-size:.79rem;color:#6c655a!important;margin-top:2.2rem}.hidden{position:absolute;overflow:hidden;clip:rect(0 0 0 0);height:1px;width:1px;margin:-1px;padding:0;border:0}form{display:grid;gap:1rem}.two-fields{display:grid;grid-template-columns:1fr 1fr;gap:1rem}label{font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;font-weight:700;color:#5c564c}label span{font-weight:400;text-transform:none;letter-spacing:0}input,select,textarea{width:100%;display:block;margin-top:.42rem;padding:.85rem;background:#fffdf8;border:1px solid #cfc5b6;color:#111;font:inherit;font-size:.94rem;letter-spacing:normal;text-transform:none;font-weight:400;border-radius:0}select{appearance:auto}textarea{resize:vertical}.privacy-note{font-size:.76rem;color:#696156;margin:0}.privacy-note a{color:#624919;text-decoration:underline}.dark-button{justify-self:start}
  .contact-cta{text-align:center;padding:6rem 1rem;background:var(--gold);color:var(--ink)}.contact-cta h2{font-size:clamp(2.55rem,5.5vw,4.7rem);margin:.65rem auto 1.65rem}.contact-cta .eyebrow{color:#5b461b}.contact-cta .button{background:#111;color:var(--ivory);border-color:#111}@media(max-width:760px){.contact-hero{padding-top:9rem;min-height:620px}.ways-grid{grid-template-columns:1fr}.contact-grid{grid-template-columns:1fr;gap:3rem}}@media(max-width:520px){.two-fields{grid-template-columns:1fr}.hero-content h1{font-size:3.45rem}}
</style>
