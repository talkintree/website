---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import { books } from '../data/books';
---
<BaseLayout title="Books by Dr. Ramesh Kayyam" description="Explore books by Dr. Ramesh Kayyam: fiction, suspense, youth education, and imaginative stories for every kind of reader.">
  <section class="books-hero">
    <div class="hero-books" aria-hidden="true">{books.slice(0, 3).map((book) => <img src={book.image} alt="" />)}</div>
    <div class="container hero-content"><p class="eyebrow">The Talkintree library</p><h1>Stories for the heart, the mind, and the future.</h1><p>Every book begins with a question, a human experience, or a possibility waiting to be explored.</p><a class="button" href="#collection">Explore the collection</a></div>
  </section>

  <section class="paper section introduction"><div class="container intro-grid"><div><p class="eyebrow">Words that connect us</p><h2 class="section-title">Books that invite you to pause, feel, and imagine.</h2></div><div><p>Dr. Ramesh Kayyam writes across fiction, psychological suspense, youth education, and children’s adventure. His work is rooted in the realities of life—our relationships, choices, challenges, hopes, and capacity for change.</p><p>Choose a title below to learn more or purchase it securely on Amazon.</p></div></div></section>

  <section id="collection" class="paper catalogue section"><div class="container"><div class="catalogue-heading"><div><p class="eyebrow">The collection</p><h2 class="section-title">Find your next journey.</h2></div><p>Available now on Amazon.</p></div><div class="book-grid">{books.map(book => <BookCard {book}/>)}</div></div></section>

  <section class="readers section"><div class="container readers-grid"><div><p class="eyebrow">For readers of every age</p><h2 class="section-title">One author. Many kinds of journeys.</h2></div><div class="reader-types"><article><span>01</span><h3>Fiction & Reflection</h3><p>Stories of love, identity, resilience, memory, and the moments that shape us.</p></article><article><span>02</span><h3>Young Minds</h3><p>Books designed to support curiosity, understanding, confidence, and imagination.</p></article><article><span>03</span><h3>More to Come</h3><p>Talkintree will continue to grow with future books, audio editions, and new ways to explore ideas.</p></article></div></div></section>

  <section class="books-cta"><div class="container"><p class="eyebrow">Stay connected</p><h2>New stories are always taking root.</h2><p>Follow Dr. Ramesh Kayyam for future releases, conversations, and ideas from Talkintree.</p><div><a class="button" href="https://www.linkedin.com/in/drrameshkayyam" target="_blank" rel="noreferrer">Connect on LinkedIn ↗</a><a class="button button--ghost" href="https://youtube.com/@talkintree?si=PSgVE2khg-98-Zc6" target="_blank" rel="noreferrer">Visit YouTube ↗</a></div></div></section>
</BaseLayout>

<style>
  .books-hero{position:relative;overflow:hidden;padding:11rem 0 6rem;min-height:650px;background:radial-gradient(circle at 70% 20%,#473719,#17130d 49%,#0d0d0d 77%)}.hero-content{position:relative;z-index:2}.hero-content h1{max-width:830px;font-size:clamp(3.6rem,7vw,6.7rem);letter-spacing:-.07em;margin:.8rem 0 1.3rem}.hero-content>p:not(.eyebrow){max-width:570px;color:#d8d1c4;font-size:1.12rem;margin-bottom:2rem}.hero-books{position:absolute;z-index:1;right:3%;bottom:-14%;display:flex;gap:1.5rem;align-items:end;opacity:.65;transform:rotate(-5deg)}.hero-books img{width:190px;aspect-ratio:3/4;object-fit:cover;box-shadow:18px 24px 40px rgba(0,0,0,.55);border:1px solid rgba(214,181,107,.3)}.hero-books img:nth-child(2){transform:translateY(-64px)}.hero-books img:nth-child(3){transform:translateY(-20px)}
  .intro{padding-bottom:5.5rem}.intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:7rem}.intro-grid>div:last-child{color:#5b564d;font-size:1.07rem}.intro-grid>div:last-child p:first-child{margin-top:0}.catalogue{padding-top:1rem}.catalogue-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:3.2rem}.catalogue-heading>p{color:#5c564c;margin:0 0 .5rem}.book-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:2rem 1.35rem}
  .readers{background:linear-gradient(120deg,#111,#152017)}.readers-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:6rem;align-items:start}.reader-types{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgba(214,181,107,.35);border-left:1px solid rgba(214,181,107,.35)}.reader-types article{min-height:235px;padding:1.4rem;border-right:1px solid rgba(214,181,107,.35);border-bottom:1px solid rgba(214,181,107,.35)}.reader-types span{color:var(--gold);font-size:.68rem;letter-spacing:.1em}.reader-types h3{font-size:1.35rem;margin:1.5rem 0 .5rem}.reader-types p{color:#beb6ab;font-size:.88rem;margin:0}
  .books-cta{text-align:center;padding:6rem 1rem;background:var(--gold);color:var(--ink)}.books-cta h2{font-size:clamp(2.6rem,5.5vw,4.7rem);margin:.6rem auto;max-width:820px}.books-cta>div>p:not(.eyebrow){max-width:570px;margin:0 auto 1.75rem}.books-cta .eyebrow{color:#5c461b}.books-cta div>div{display:flex;justify-content:center;gap:.8rem;flex-wrap:wrap}.books-cta .button{background:#111;color:var(--ivory);border-color:#111}.books-cta .button--ghost{background:transparent;color:#111;border-color:#111}
  @media(max-width:1050px){.book-grid{grid-template-columns:repeat(3,1fr)}.hero-books{right:-16%}.readers-grid{grid-template-columns:1fr;gap:3rem}}@media(max-width:760px){.books-hero{min-height:600px;padding-top:9rem}.hero-books{right:-37%;opacity:.28}.intro-grid{grid-template-columns:1fr;gap:2rem}.reader-types{grid-template-columns:1fr}.catalogue-heading{align-items:start;flex-direction:column}}@media(max-width:520px){.book-grid{grid-template-columns:repeat(2,1fr);gap:2rem 1rem}.hero-books{display:none}.hero-content h1{font-size:3.45rem}}
</style>
