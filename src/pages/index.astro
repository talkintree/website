---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import { books } from '../data/books';
---
<BaseLayout title="Talkintree | Ideas That Grow" description="Talkintree is the home of Dr. Ramesh Kayyam: author, leadership scholar, speaker, and educator.">
  <section class="hero" data-hero><div class="hero-art" aria-hidden="true"></div><div class="hero-roots" aria-hidden="true"></div><div class="hero-glow glow-one" aria-hidden="true"></div><div class="hero-glow glow-two" aria-hidden="true"></div><div class="hero-grain"></div><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow hero-reveal reveal-one">Author · Leadership Scholar · Speaker</p><h1 class="hero-reveal reveal-two">Where stories grow into wisdom.</h1><p class="lede hero-reveal reveal-three">Talkintree is a home for books, bold ideas, and human-centered leadership in an age of artificial intelligence.</p><div class="actions hero-reveal reveal-four"><a class="button" href="/books">Explore the books</a><a class="button button--ghost" href="/speaking">Invite Dr. Ramesh</a></div><p class="hero-signature hero-reveal reveal-five">Dr. Ramesh Kayyam <span>—</span> Ideas that grow. Leadership that matters.</p></div></div><div class="scroll-note">SCROLL TO EXPLORE <span>↓</span></div></section>

  <section class="paper section"><div class="container introduction"><div class="portrait-wrap"><img src="/images/dr-ramesh-kayyam.png" alt="Dr. Ramesh Kayyam" loading="lazy"/><p>Dr. Ramesh Kayyam</p></div><div class="intro-copy"><p class="eyebrow">Welcome to Talkintree</p><h2 class="section-title">A place for ideas with roots—and a future.</h2><div class="gold-rule"></div><p class="section-copy">Founded by Dr. Ramesh Kayyam, Talkintree brings together leadership, technology, storytelling, education, and human potential. It is for the curious thinker, the purposeful leader, and everyone who believes progress must remain deeply human.</p><a class="button dark-button" href="/about">Meet Dr. Ramesh</a></div></div></section>

  <section class="section paths"><div class="container"><p class="eyebrow">Choose your journey</p><h2 class="section-title">Explore the branches of Talkintree.</h2><div class="path-grid"><a href="/leadership" class="path"><span>01</span><h3>Leadership</h3><p>Navigate the AI era with wisdom, ethics, and purpose.</p></a><a href="/books" class="path"><span>02</span><h3>Stories</h3><p>Fiction and ideas that illuminate the human experience.</p></a><a href="/speaking" class="path"><span>03</span><h3>Speaking</h3><p>Conversations and workshops that inspire meaningful action.</p></a><a href="/blog" class="path"><span>04</span><h3>Thought Garden</h3><p>Reflections on society, technology, learning, and life.</p></a></div></div></section>

  <section class="paper section books"><div class="container"><div class="section-heading"><div><p class="eyebrow">Featured works</p><h2 class="section-title">Books for every kind of journey.</h2></div><a class="button dark-button" href="/books">View all books</a></div><div class="book-grid">{books.map(book => <BookCard {book}/>)}</div></div></section>

  <section class="ai-section section"><div class="container ai-grid"><div><p class="eyebrow">Leadership in the AI era</p><h2 class="section-title">The future needs human leadership.</h2><div class="gold-rule"></div><p class="section-copy">Technology changes the tools in our hands. Leadership shapes the future we create. Explore practical, human-centered perspectives on AI, work, innovation, and organizational change.</p><a class="button" href="/leadership">Explore insights</a></div><div class="principles"><div><b>01</b><h3>Ethical AI</h3><p>Innovation guided by values.</p></div><div><b>02</b><h3>Human Potential</h3><p>Technology that expands possibility.</p></div><div><b>03</b><h3>Future of Work</h3><p>Leading people through change.</p></div><div><b>04</b><h3>Purposeful Strategy</h3><p>Progress with a clear direction.</p></div></div></div></section>

  <section class="section speaking"><div class="container speaking-grid"><div class="quote-mark">“</div><div><p class="eyebrow">Speaking & workshops</p><h2 class="section-title">Ideas that move from the stage into action.</h2><p class="section-copy">Dr. Ramesh Kayyam speaks to organizations, universities, and leadership communities about the evolving relationship between technology, leadership, and humanity.</p><a class="button" href="/speaking">Explore speaking</a></div></div></section>

  <section class="newsletter"><div class="container"><p class="eyebrow">Join the journey</p><h2>Receive new ideas from Talkintree.</h2><p>Reflections on leadership, technology, humanity, and personal growth—delivered with intention.</p><a class="button" href="/contact">Stay connected</a></div></section>
</BaseLayout>
<style>
.hero{--parallax-x:0px;--parallax-y:0px;min-height:790px;position:relative;overflow:hidden;background:#0d0d0d;padding-top:82px}.hero-art{position:absolute;inset:-22px;background:linear-gradient(90deg,#0d0d0d 0%,rgba(13,13,13,.89) 30%,rgba(13,13,13,.13) 75%,rgba(13,13,13,.32)),url('/images/hero-ai-tree.png') center right/cover no-repeat;transform:translate3d(var(--parallax-x),var(--parallax-y),0) scale(1.04);transition:transform .9s cubic-bezier(.2,.8,.2,1)}.hero-roots{position:absolute;z-index:1;right:3%;bottom:-24%;width:62%;height:55%;opacity:.55;background:repeating-radial-gradient(ellipse at 50% 100%,transparent 0 7%,rgba(214,181,107,.14) 7.5% 8.1%,transparent 8.8% 15%);filter:blur(.7px);mask-image:linear-gradient(to top,black,transparent 82%);animation:root-flow 7s ease-in-out infinite}.hero-glow{position:absolute;z-index:1;width:11px;height:11px;border-radius:50%;background:#f9e6b0;box-shadow:0 0 17px 6px rgba(214,181,107,.65);animation:book-glow 3.7s ease-in-out infinite}.glow-one{right:29%;top:31%}.glow-two{right:11%;top:40%;animation-delay:1.55s}.hero-grain{position:absolute;inset:0;opacity:.15;background-image:radial-gradient(#fff .5px,transparent .5px);background-size:7px 7px;mask-image:linear-gradient(black,transparent)}.hero-grid{position:relative;z-index:2;min-height:708px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center}.hero-copy{max-width:640px;z-index:2}.hero h1{font-size:clamp(3.7rem,7vw,6.8rem);letter-spacing:-.06em;margin:.85rem 0 1.35rem}.lede{max-width:530px;color:#d1cbc0;font-size:1.15rem}.actions{display:flex;gap:1rem;margin-top:2.2rem;flex-wrap:wrap}.hero-signature{font-family:'Playfair Display',Georgia,serif;color:#d9d1c3;margin-top:3.5rem;font-size:.92rem}.hero-signature span{color:var(--gold);margin:0 .35rem}.hero-reveal{opacity:0;transform:translateY(22px);animation:reveal-up .85s cubic-bezier(.2,.7,.2,1) forwards}.reveal-one{animation-delay:.18s}.reveal-two{animation-delay:.32s}.reveal-three{animation-delay:.48s}.reveal-four{animation-delay:.64s}.reveal-five{animation-delay:.8s}.scroll-note{position:absolute;z-index:3;bottom:22px;left:50%;transform:translateX(-50%);font-size:.62rem;letter-spacing:.15em;color:#bdb4a6}.scroll-note span{color:var(--gold);font-size:1rem;margin-left:.6rem;animation:scroll-hint 2.1s ease-in-out infinite}.introduction{display:grid;grid-template-columns:.75fr 1.25fr;column-gap:7rem;align-items:start}.portrait-wrap{position:relative}.portrait-wrap img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:center;filter:saturate(.85)}.portrait-wrap p{position:absolute;bottom:0;left:0;margin:0;padding:.65rem .85rem;background:var(--gold);color:#111;font-weight:700;font-size:.68rem;text-transform:uppercase;letter-spacing:.08em}.intro-copy .section-title{margin-top:.55rem}.dark-button{background:var(--ink);color:var(--ivory);border-color:var(--ink);margin-top:1rem}.path-grid{margin-top:3.5rem;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(214,181,107,.3);border-left:1px solid rgba(214,181,107,.3)}.path{min-height:255px;border-right:1px solid rgba(214,181,107,.3);border-bottom:1px solid rgba(214,181,107,.3);padding:1.4rem;transition:.25s}.path:hover{background:#1c1c1b;transform:translateY(-6px)}.path span{color:var(--gold);font-size:.72rem}.path h3{font-size:1.7rem;margin-top:3.1rem}.path p{font-size:.88rem;color:#b5ada1}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:3.2rem}.book-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}.books .book-grid{grid-template-columns:repeat(5,1fr);gap:1.3rem}.ai-section{background:linear-gradient(125deg,#102017,#101010 57%)}.ai-grid{display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:center}.principles{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid rgba(214,181,107,.35);border-left:1px solid rgba(214,181,107,.35)}.principles div{padding:1.5rem;border-right:1px solid rgba(214,181,107,.35);border-bottom:1px solid rgba(214,181,107,.35)}.principles b{color:var(--gold);font-size:.7rem}.principles h3{margin:.8rem 0 .4rem;font-size:1.25rem}.principles p{font-size:.84rem;color:#bdb4a7;margin:0}.speaking{background:#111}.speaking-grid{display:grid;grid-template-columns:.45fr 1.55fr;gap:3rem;align-items:center}.quote-mark{font-family:Georgia,serif;font-size:18rem;line-height:.5;color:var(--gold);text-align:center}.newsletter{text-align:center;padding:6rem 1rem;background:var(--gold);color:var(--ink)}.newsletter h2{font-size:clamp(2.5rem,5vw,4.4rem);margin:.6rem auto;max-width:760px}.newsletter p:not(.eyebrow){max-width:600px;margin:0 auto 1.6rem}.newsletter .eyebrow{color:#4e3d1d}.newsletter .button{background:var(--ink);color:var(--ivory);border-color:var(--ink)}@keyframes reveal-up{to{opacity:1;transform:translateY(0)}}@keyframes book-glow{0%,100%{opacity:.35;transform:scale(.7)}50%{opacity:1;transform:scale(1.2)}}@keyframes root-flow{0%,100%{opacity:.22;transform:scale(.96)}50%{opacity:.62;transform:scale(1.04)}}@keyframes scroll-hint{50%{transform:translateY(5px)}}@media(prefers-reduced-motion:reduce){.hero-art{transform:scale(1.04)!important}.hero-reveal{animation:none;opacity:1;transform:none}.hero-roots,.hero-glow,.scroll-note span{animation:none}}@media(max-width:1000px){.books .book-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:800px){.hero{min-height:auto}.hero-grid{grid-template-columns:1fr;min-height:auto;padding:8rem 0 3rem}.hero-art{background:linear-gradient(180deg,rgba(13,13,13,.24),#0d0d0d 88%),url('/images/hero-ai-tree.png') 61% top/cover no-repeat}.hero-roots{width:100%;right:0}.glow-one{right:30%;top:27%}.glow-two{right:9%;top:38%}.introduction,.ai-grid{grid-template-columns:1fr;gap:2rem}.portrait-wrap{max-width:430px}.path-grid,.book-grid{grid-template-columns:repeat(2,1fr)}.books .book-grid{grid-template-columns:repeat(2,1fr)}.ai-grid{gap:3rem}.speaking-grid{grid-template-columns:1fr}.quote-mark{display:none}.section-heading{align-items:flex-start;flex-direction:column}}@media(max-width:500px){.path-grid,.book-grid,.principles,.books .book-grid{grid-template-columns:1fr}.hero h1{font-size:3.45rem}}
</style>
<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canAnimate = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hero && canAnimate && window.matchMedia('(pointer: fine)').matches) {
    hero.addEventListener('pointermove', (event) => {
      const rect = hero.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - .5;
      const y = (event.clientY - rect.top) / rect.height - .5;
      hero.style.setProperty('--parallax-x', `${x * -12}px`);
      hero.style.setProperty('--parallax-y', `${y * -8}px`);
    });
    hero.addEventListener('pointerleave', () => {
      hero.style.setProperty('--parallax-x', '0px');
      hero.style.setProperty('--parallax-y', '0px');
    });
  }
</script>
