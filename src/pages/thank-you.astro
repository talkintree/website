---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Thank You" description="Thank you for contacting Talkintree.">
  <main class="thank-you"><div class="container"><p class="eyebrow">Message received</p><h1>Thank you for reaching out.</h1><p>Your message has been received. Dr. Ramesh Kayyam will respond as soon as possible.</p><div><a class="button" href="/">Return home</a><a class="button button--ghost" href="/blog">Visit Thought Garden</a></div></div></main>
</BaseLayout>
<style>
  .thank-you{min-height:80vh;display:grid;place-items:center;text-align:center;padding:9rem 0 5rem;background:radial-gradient(circle at 50% 30%,#324b35,#121712 52%,#0d0d0d 78%)}.thank-you h1{font-size:clamp(3.4rem,7vw,6.5rem);letter-spacing:-.07em;margin:.8rem auto 1.2rem}.thank-you p:not(.eyebrow){max-width:580px;margin:0 auto 2rem;color:#d0c8bc;font-size:1.1rem}.thank-you div{display:flex;justify-content:center;gap:.8rem;flex-wrap:wrap}
</style>
