---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About Dr. Ramesh Kayyam" description="Meet Dr. Ramesh Kayyam—author, leadership scholar, speaker, and educator behind Talkintree.">
  <section class="about-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">About Dr. Ramesh Kayyam</p>
        <h1>A life of ideas, stories, and meaningful change.</h1>
        <p>Dr. Ramesh Kayyam is an author, leadership scholar, speaker, and lifelong learner whose work brings together technology, human potential, education, and story.</p>
        <div class="hero-facts">
          <span>Author</span><span>Leadership Scholar</span><span>Speaker & Educator</span>
        </div>
      </div>
      <figure class="portrait"><img src="/images/dr-ramesh-kayyam-portrait.png" alt="Portrait of Dr. Ramesh Kayyam"/><figcaption>Dr. Ramesh Kayyam</figcaption></figure>
    </div>
  </section>

  <section class="paper section">
    <div class="container story-grid">
      <div><p class="eyebrow">The story behind Talkintree</p><h2 class="section-title">Knowledge should help us become more human—not less.</h2><div class="gold-rule"></div></div>
      <div class="story-copy">
        <p>Talkintree is the creative and intellectual home of Dr. Ramesh Kayyam. It is a place for questions that deserve more than quick answers: How should we lead? What does technology ask of us? How do stories help us understand one another?</p>
        <p>With a Ph.D. in Leadership, Dr. Kayyam explores the relationship between ethical leadership, organizational change, artificial intelligence, and human potential. His work is grounded in the belief that progress matters most when it is guided by wisdom, empathy, and purpose.</p>
        <p>Across books, research, speaking, and educational work, he invites people to meet a changing world with curiosity, courage, and humanity.</p>
      </div>
    </div>
  </section>

  <section class="section work">
    <div class="container"><p class="eyebrow">Four expressions of the work</p><h2 class="section-title">One purpose. Many ways to serve it.</h2><div class="work-grid">
      <article><span>01</span><h3>Stories</h3><p>Fiction and reflection that explore identity, resilience, love, and the human experience.</p><a href="/books">Explore the books <i>↗</i></a></article>
      <article><span>02</span><h3>Leadership</h3><p>Human-centered perspectives on leadership, change, ethical decision-making, and the future of work.</p><a href="/leadership">Explore leadership <i>↗</i></a></article>
      <article><span>03</span><h3>Speaking</h3><p>Engaging conversations for organizations, universities, students, and lifelong learners.</p><a href="/speaking">Invite Dr. Ramesh <i>↗</i></a></article>
      <article><span>04</span><h3>Learning</h3><p>Ideas and resources designed to make learning a continuing practice, not a finished destination.</p><a href="/blog">Visit Thought Garden <i>↗</i></a></article>
    </div></div>
  </section>

  <section class="beliefs paper section"><div class="container beliefs-grid"><div><p class="eyebrow">What guides the work</p><h2 class="section-title">The values at the root of every idea.</h2></div><div class="belief-list"><article><b>Humanity</b><p>Progress is valuable when it honors dignity, connection, and purpose.</p></article><article><b>Curiosity</b><p>Questions are the roots of learning, imagination, and innovation.</p></article><article><b>Responsibility</b><p>Technology and leadership should be exercised with care for people and the future.</p></article><article><b>Possibility</b><p>Change can become an opening when we meet it with courage and intention.</p></article></div></div></section>

  <section class="invitation"><div class="container"><p class="eyebrow">Continue the conversation</p><h2>Let’s explore what meaningful leadership can make possible.</h2><a class="button" href="/contact">Connect with Dr. Ramesh</a></div></section>
</BaseLayout>

<style>
  .about-hero{padding:9.5rem 0 5.5rem;background:radial-gradient(circle at 80% 20%,#294530 0, #121312 46%,#0d0d0d 75%)}
  .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:7rem;align-items:center}.hero-copy h1{font-size:clamp(3.6rem,6.5vw,6.2rem);letter-spacing:-.065em;margin:1rem 0 1.45rem}.hero-copy>p:not(.eyebrow){max-width:610px;color:#d3ccc0;font-size:1.12rem}.hero-facts{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:2.2rem}.hero-facts span{border:1px solid rgba(214,181,107,.5);padding:.45rem .65rem;color:var(--gold-light);font-size:.65rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.portrait{margin:0;position:relative;aspect-ratio:4/5;background:#cfc5b3;overflow:hidden;border:1px solid rgba(214,181,107,.55)}.portrait:before{content:'';position:absolute;z-index:1;inset:0;background:linear-gradient(180deg,transparent 52%,rgba(13,13,13,.42));pointer-events:none}.portrait img{width:100%;height:100%;display:block;object-fit:cover;object-position:center top;filter:saturate(.87)}.portrait figcaption{position:absolute;z-index:2;bottom:0;left:0;margin:0;padding:.8rem 1rem;color:#111;background:var(--gold);font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .story-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:7rem}.story-copy{font-size:1.08rem;color:#58534b}.story-copy p:first-child{margin-top:0}.story-copy p{margin-bottom:1.45rem}
  .work{background:#111}.work-grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:3.5rem;border-top:1px solid rgba(214,181,107,.3);border-left:1px solid rgba(214,181,107,.3)}.work-grid article{min-height:300px;padding:1.6rem;border-right:1px solid rgba(214,181,107,.3);border-bottom:1px solid rgba(214,181,107,.3);display:flex;flex-direction:column;transition:background .25s ease,transform .25s ease}.work-grid article:hover{background:#1c1c1b;transform:translateY(-5px)}.work-grid span{font-size:.7rem;color:var(--gold);letter-spacing:.1em}.work-grid h3{font-size:1.8rem;margin:2.5rem 0 .65rem}.work-grid p{color:#c4bdb2;font-size:.92rem;margin:0}.work-grid a{margin-top:auto;color:var(--gold-light);font-size:.7rem;letter-spacing:.09em;text-transform:uppercase;font-weight:700}.work-grid i{font-style:normal;margin-left:.3rem}
  .beliefs-grid{display:grid;grid-template-columns:1fr 1fr;gap:7rem}.belief-list{border-top:1px solid #d9ceba}.belief-list article{display:grid;grid-template-columns:.8fr 1.2fr;gap:1rem;padding:1.25rem 0;border-bottom:1px solid #d9ceba}.belief-list b{font-family:'Playfair Display',Georgia,serif;font-size:1.3rem}.belief-list p{margin:0;color:#59544b;font-size:.94rem}
  .invitation{text-align:center;padding:6.3rem 1rem;background:var(--gold);color:var(--ink)}.invitation h2{font-size:clamp(2.6rem,5.5vw,4.6rem);max-width:850px;margin:.7rem auto 1.75rem}.invitation .eyebrow{color:#5b461c}.invitation .button{background:#111;color:var(--ivory);border-color:#111}
  @media(max-width:850px){.hero-grid,.story-grid,.beliefs-grid{grid-template-columns:1fr;gap:3rem}.portrait{max-width:440px}.work-grid{grid-template-columns:repeat(2,1fr)}.about-hero{padding-top:8rem}}@media(max-width:540px){.work-grid{grid-template-columns:1fr}.belief-list article{grid-template-columns:1fr;gap:.35rem}.hero-copy h1{font-size:3.45rem}}
</style>
