---
import BaseLayout from '../layouts/BaseLayout.astro';
const themes = [
  ['01', 'Leadership', 'Ethical leadership, adaptive change, organizational life, and the choices that shape a future.'],
  ['02', 'AI & Humanity', 'Human-centered perspectives on artificial intelligence, innovation, and responsibility.'],
  ['03', 'Society & Philosophy', 'Reflections on meaning, relationships, identity, culture, and how we live together.'],
  ['04', 'Learning & Growth', 'Ideas for students, educators, professionals, and lifelong learners.'],
  ['05', 'Stories & Storytelling', 'The lessons, emotions, and human truths that live inside a good story.'],
  ['06', 'Personal Reflections', 'Quiet observations from a life of learning, listening, and meaningful change.']
];
const comingSoon = [
  ['Leadership', 'What Human Leadership Means in an AI-First World', 'A reflection on the qualities that matter most as technology transforms the nature of work.'],
  ['AI & Humanity', 'The Questions We Should Ask Before We Build', 'Innovation is not only about what is possible—it is also about what is worth creating.'],
  ['Learning & Growth', 'A Lifelong Learner’s Compass', 'Curiosity, humility, and reflection are practical strengths for an uncertain world.']
];
---
<BaseLayout title="Thought Garden" description="Thought Garden is the Talkintree journal: reflections on leadership, artificial intelligence, society, learning, storytelling, and human potential.">
  <section class="garden-hero"><div class="leaf leaf-one" aria-hidden="true"></div><div class="leaf leaf-two" aria-hidden="true"></div><div class="container hero-content"><p class="eyebrow">Thought Garden</p><h1>Ideas need space to grow.</h1><p>Reflections on leadership, artificial intelligence, society, philosophy, education, storytelling, and human potential.</p><a class="button" href="#themes">Explore the garden</a></div></section>

  <section class="paper section manifesto"><div class="container manifesto-grid"><div><p class="eyebrow">A place for reflection</p><h2 class="section-title">Not every idea needs an immediate answer.</h2><div class="gold-rule"></div></div><div><p>Thought Garden is where Talkintree makes room for questions, reflection, and meaningful conversation. It is a growing collection of essays and observations for people who want to lead with more wisdom, understand technology more deeply, and remain curious about the human experience.</p><p>New writing will be added here over time. Until then, consider this an open invitation to pause, think, and return.</p></div></div></section>

  <section id="themes" class="section themes"><div class="container"><p class="eyebrow">Explore by theme</p><h2 class="section-title">Six branches of the garden.</h2><div class="theme-grid">{themes.map(([number, title, description]) => <article><span>{number}</span><h3>{title}</h3><p>{description}</p><small>New reflections coming soon</small></article>)}</div></div></section>

  <section class="paper section coming"><div class="container"><div class="coming-heading"><div><p class="eyebrow">Beginning soon</p><h2 class="section-title">The first seeds.</h2></div><p>Three opening reflections now taking root.</p></div><div class="post-grid">{comingSoon.map(([category, title, excerpt], index) => <article><p class="eyebrow">{category} · Coming soon</p><span>0{index + 1}</span><h3>{title}</h3><p>{excerpt}</p><a href="/contact">Receive the first reflection ↗</a></article>)}</div></div></section>

  <section class="garden-cta"><div class="container"><p class="eyebrow">Grow with Talkintree</p><h2>Receive new ideas when they are ready to bloom.</h2><p>Join the conversation on leadership, technology, humanity, and lifelong learning.</p><a class="button" href="/contact">Stay connected</a></div></section>
</BaseLayout>

<style>
  .garden-hero{position:relative;overflow:hidden;min-height:650px;padding:11rem 0 6rem;background:radial-gradient(circle at 76% 24%,#2a4e39 0,#142119 43%,#0d0d0d 76%)}.hero-content{position:relative;z-index:2}.hero-content h1{font-size:clamp(3.7rem,7vw,6.8rem);letter-spacing:-.07em;margin:.8rem 0 1.25rem}.hero-content>p:not(.eyebrow){max-width:600px;color:#d5cec1;font-size:1.12rem;margin-bottom:2rem}.leaf{position:absolute;border:1px solid rgba(214,181,107,.2);border-radius:100% 0 100% 0;transform:rotate(35deg);animation:float 8s ease-in-out infinite}.leaf-one{width:380px;height:650px;right:12%;bottom:-190px}.leaf-two{width:260px;height:440px;right:35%;top:-210px;opacity:.55;animation-delay:1.6s}.manifesto-grid{display:grid;grid-template-columns:1fr 1fr;gap:7rem}.manifesto-grid>div:last-child{color:#59544b;font-size:1.07rem}.manifesto-grid>div:last-child p:first-child{margin-top:0}.themes{background:#111}.theme-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:3.5rem;border-top:1px solid rgba(214,181,107,.32);border-left:1px solid rgba(214,181,107,.32)}.theme-grid article{min-height:265px;padding:1.45rem;border-right:1px solid rgba(214,181,107,.32);border-bottom:1px solid rgba(214,181,107,.32);display:flex;flex-direction:column;transition:.25s ease}.theme-grid article:hover{background:#1a1e1b;transform:translateY(-5px)}.theme-grid span{color:var(--gold);font-size:.68rem;letter-spacing:.1em}.theme-grid h3{font-size:1.55rem;margin:2rem 0 .55rem}.theme-grid p{color:#c4bdb1;font-size:.89rem;margin:0}.theme-grid small{margin-top:auto;color:var(--gold-light);text-transform:uppercase;letter-spacing:.08em;font-size:.6rem;font-weight:700}.coming-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:3rem}.coming-heading>p{color:#59544b;margin:0 0 .5rem}.post-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.3rem}.post-grid article{border:1px solid #ded6c9;padding:1.6rem;min-height:325px;display:flex;flex-direction:column}.post-grid span{color:#af8b41;font-family:'Playfair Display',Georgia,serif;font-size:2.5rem;line-height:1;margin:3rem 0 1.1rem}.post-grid h3{font-size:1.6rem}.post-grid p:not(.eyebrow){color:#5d574d;font-size:.91rem}.post-grid a{margin-top:auto;color:#70541e;font-size:.69rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.garden-cta{text-align:center;padding:6.2rem 1rem;background:var(--gold);color:var(--ink)}.garden-cta h2{font-size:clamp(2.55rem,5.5vw,4.65rem);max-width:850px;margin:.7rem auto}.garden-cta>div>p:not(.eyebrow){max-width:560px;margin:0 auto 1.65rem}.garden-cta .eyebrow{color:#5d461c}.garden-cta .button{background:#111;color:var(--ivory);border-color:#111}@keyframes float{50%{transform:rotate(42deg) translateY(-16px)}}@media(prefers-reduced-motion:reduce){.leaf{animation:none}}@media(max-width:800px){.manifesto-grid{grid-template-columns:1fr;gap:2.5rem}.theme-grid{grid-template-columns:repeat(2,1fr)}.post-grid{grid-template-columns:1fr}.coming-heading{align-items:start;flex-direction:column}}@media(max-width:520px){.garden-hero{padding-top:9rem;min-height:600px}.theme-grid{grid-template-columns:1fr}.leaf{opacity:.3}.hero-content h1{font-size:3.5rem}}
</style>
