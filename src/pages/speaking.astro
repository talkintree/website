---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Speaking & Workshops" description="Invite Dr. Ramesh Kayyam to speak on leadership, human-centered AI, change, and the future of work.">
<section class="page-hero"><div class="container"><p class="eyebrow">Speaking & Workshops</p><h1>Conversations that inspire action.</h1><p>Dr. Ramesh Kayyam brings an engaging, human perspective to leadership, technology, change, and lifelong learning.</p><a class="button" href="/contact">Request an engagement</a></div></section>
<section class="paper section"><div class="container"><p class="eyebrow">Signature topics</p><div class="topic-list"><article><h2>Leadership in the AI Era</h2><p>Preparing leaders to meet rapid technological change with confidence, purpose, and ethical clarity.</p></article><article><h2>Human-Centered Artificial Intelligence</h2><p>Balancing innovation with empathy, wisdom, and responsibility.</p></article><article><h2>The Future of Work</h2><p>Helping organizations and individuals navigate change, automation, and new possibilities.</p></article><article><h2>Strategic Leadership & Transformation</h2><p>Building the clarity and resilience needed to move from disruption to meaningful progress.</p></article></div></div></section>
<section class="section"><div class="container audiences"><div><p class="eyebrow">For audiences ready to grow</p><h2 class="section-title">Bring a meaningful conversation to your community.</h2></div><div><p>Available for conferences, universities, corporate events, leadership retreats, and virtual sessions.</p><a href="/contact" class="button">Start a conversation</a></div></div></section>
</BaseLayout>
<style>.page-hero{padding:11rem 0 5rem;background:radial-gradient(circle at 70% 20%,#554126,#111 62%)}h1{font-size:clamp(3.4rem,7vw,6.4rem);letter-spacing:-.06em;margin:.8rem 0}.page-hero p:not(.eyebrow){font-size:1.1rem;color:#d0c8bb;max-width:600px;margin-bottom:2rem}.topic-list{margin-top:2.5rem;border-top:1px solid #d9d1c4}.topic-list article{padding:1.9rem 0;border-bottom:1px solid #d9d1c4;display:grid;grid-template-columns:1fr 1fr;gap:2rem}.topic-list h2{font-size:1.7rem}.topic-list p{margin:0;color:#5d574e}.audiences{display:grid;grid-template-columns:1fr 1fr;gap:5rem}.audiences p:not(.eyebrow){color:#c8c0b5;font-size:1.08rem;margin-top:2rem}.audiences .button{margin-top:1rem}@media(max-width:620px){.topic-list article,.audiences{grid-template-columns:1fr;gap:1rem}}</style>
