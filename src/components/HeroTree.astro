---
const { compact = false } = Astro.props;
---
<div class:list={['tree-scene', { compact }]} aria-label="Abstract golden tree representing growing ideas" role="img">
  <div class="halo"></div><div class="canopy canopy-one"></div><div class="canopy canopy-two"></div><div class="canopy canopy-three"></div><div class="trunk"></div><div class="roots"></div><div class="spark s1"></div><div class="spark s2"></div><div class="spark s3"></div><div class="spark s4"></div>
</div>
<style>
 .tree-scene{position:relative;width:min(630px,80vw);height:610px;isolation:isolate}.halo{position:absolute;inset:15% 5% 7%;background:radial-gradient(circle,rgba(214,181,107,.22),transparent 65%);filter:blur(10px)}.canopy{position:absolute;border:1px solid rgba(244,223,170,.7);border-radius:52% 48% 48% 52%;background:radial-gradient(ellipse at 35% 32%,rgba(214,181,107,.43),rgba(37,67,50,.3) 53%,transparent 70%);box-shadow:0 0 45px rgba(214,181,107,.1)}.canopy-one{width:53%;height:43%;left:20%;top:12%;transform:rotate(-15deg)}.canopy-two{width:45%;height:37%;left:42%;top:25%;transform:rotate(27deg)}.canopy-three{width:40%;height:35%;left:9%;top:32%;transform:rotate(25deg)}.trunk{position:absolute;z-index:-1;bottom:13%;left:47%;height:53%;width:8%;background:linear-gradient(90deg,#6b5125,var(--gold),#7d5d28);clip-path:polygon(42% 0,80% 0,68% 50%,100% 100%,0 100%,35% 50%);border-radius:40%}.roots{position:absolute;bottom:8%;left:17%;width:66%;height:24%;background:linear-gradient(90deg,transparent 5%,#735728 20%,var(--gold) 50%,#735728 80%,transparent 95%);clip-path:polygon(47% 0,54% 0,60% 40%,100% 100%,69% 65%,50% 100%,34% 65%,0 100%,40% 40%);opacity:.85}.spark{position:absolute;width:5px;height:5px;border-radius:50%;background:var(--gold-light);box-shadow:0 0 12px 4px rgba(244,223,170,.7);animation:pulse 2.6s ease-in-out infinite}.s1{top:18%;left:28%}.s2{top:33%;right:18%;animation-delay:.7s}.s3{top:47%;left:15%;animation-delay:1.4s}.s4{top:10%;right:32%;animation-delay:2s}@keyframes pulse{50%{opacity:.25;transform:scale(.55)}}.compact{height:360px;width:min(420px,82vw)}.compact .trunk{bottom:8%}.compact .roots{bottom:3%}@media(max-width:700px){.tree-scene{height:440px}.compact{height:300px}}
</style>
