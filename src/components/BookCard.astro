---
const { book } = Astro.props;
---
<article class="book-card">
  <a class="cover-link" href={book.amazonUrl} target="_blank" rel="noreferrer" aria-label={`View ${book.title} on Amazon`}><img class="cover" src={book.image} alt={`Book cover: ${book.title}`} loading="lazy"/></a>
  <div><p class="eyebrow">{book.category}</p><h3>{book.title}</h3><p>{book.description}</p><a href={book.amazonUrl} class="text-link" target="_blank" rel="noreferrer">View on Amazon →</a></div>
</article>
<style>
 .book-card{display:grid;gap:1rem}.cover-link{display:block;overflow:hidden;background:var(--cover);box-shadow:12px 16px 22px rgba(0,0,0,.27)}.cover{width:100%;aspect-ratio:3/4;object-fit:cover;display:block;transition:transform .35s ease}.cover-link:hover .cover{transform:scale(1.035)}.book-card h3{font-size:1.3rem}.book-card p:not(.eyebrow){color:#aaa297;font-size:.9rem;margin:.55rem 0}.text-link{color:var(--gold);font-size:.72rem;letter-spacing:.09em;text-transform:uppercase;font-weight:700}
</style>
