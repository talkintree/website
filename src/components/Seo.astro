---
interface Props { title?: string; description?: string; image?: string; }
const { title = 'Talkintree | Leadership, Technology & Humanity', description = 'The digital home of Dr. Ramesh Kayyam — author, leadership scholar, speaker, and educator.', image = '/images/hero-ai-tree.png' } = Astro.props;
const fullTitle = title.includes('Talkintree') ? title : `${title} | Talkintree`;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
<meta property="og:type" content="website" /><meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} /><meta property="og:image" content={new URL(image, Astro.site)} />
<meta name="twitter:card" content="summary_large_image" />
